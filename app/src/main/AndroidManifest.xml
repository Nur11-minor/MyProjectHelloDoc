        <activity
            android:name=".ReceiverProfileActivity"
            android:exported="false" />


        <activity
            android:name=".CaregiverProfileActivity"
            android:exported="false" />

        <activity
            android:name=".DoctorDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".MedicalRecordsActivity"
            android:exported="false" />
        <activity
            android:name=".PrescriptionsActivity"
            android:exported="false" />
        <activity
            android:name=".TestResultsActivity"
            android:exported="false" />
        <activity
            android:name=".HelpSupportActivity"
            android:exported="false" />
        <activity
            android:name=".BookAppointmentActivity"
            android:exported="false" />
        <activity
            android:name=".item_appoinment"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".item_care_received"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".item_doctor"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>